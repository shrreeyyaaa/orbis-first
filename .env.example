# Supabase project credentials (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Not used by the app at runtime; only needed for admin scripts.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: live FX rate refresh. Free, no-key, ECB-backed.
EXCHANGE_RATE_API_BASE=https://api.frankfurter.app

# Optional: set to "false" to hide the Apple sign-in button until you've
# configured Apple as a provider in Supabase (Apple requires a paid dev account).
NEXT_PUBLIC_ENABLE_APPLE_SSO=false

# Optional: enables the full "Ask Orbis" AI assistant. Without a key, the
# assistant still answers common questions from your data via a built-in
# responder. Provide ONE of these (OpenAI takes precedence).
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-3-5-haiku-latest

# Optional, local only: run without Supabase using a file-backed stand-in
# (.mock-db.json). Sign in with demo@orbis.dev / demo1234. Never set this on Vercel.
# NEXT_PUBLIC_DEMO_MODE=true
